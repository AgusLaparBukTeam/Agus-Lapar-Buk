[Unit]
Description=Deploy GateGuard when a new main commit is available
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=gateguardadmin
Group=gateguardadmin
WorkingDirectory=/opt/gateguard
ExecStart=/usr/local/sbin/gateguard-deploy-if-new
TimeoutStartSec=45min
Nice=10
