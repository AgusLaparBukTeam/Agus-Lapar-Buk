# Local development defaults. Do not reuse these settings for Internet-facing production.
APP_ENV=development
DATABASE_URL=sqlite:///./gateguard.db
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
DOCUMENT_STORAGE_ROOT=./uploads
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
MAX_PDF_PAGES=50
MAX_PDF_TEXT_CHARS=500000
MAX_IMAGE_PIXELS=40000000
RATE_LIMIT_REQUESTS=180
RATE_LIMIT_WINDOW_SECONDS=60
APP_API_KEY=
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false

# Extraction: auto | local | openai | paddle
EXTRACTION_PROVIDER=auto
CRITICAL_CONFIDENCE_THRESHOLD=0.75
MAX_AI_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=10

# Optional OpenAI multimodal extraction fallback.
# Never expose this key to the browser. `store=false` is sent for Responses API calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=45

# Optional local PaddleOCR / PP-StructureV3.
PADDLE_DEVICE=cpu

# Frontend BFF (server-side only; never NEXT_PUBLIC)
BACKEND_API_URL=http://localhost:8000
BACKEND_API_KEY=
BACKEND_TIMEOUT_MS=60000
