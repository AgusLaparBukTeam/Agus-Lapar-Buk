# Required production values. Generate independent random secrets; never commit this file as `.env`.
APP_ENV=production
APP_PUBLIC_ORIGIN=https://gateguard.example.com
CORS_ORIGINS=https://gateguard.example.com
APP_API_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHAR_SERVICE_SECRET
SUPERVISOR_OVERRIDE_KEY=REPLACE_WITH_DIFFERENT_RANDOM_24_PLUS_CHAR_SECRET
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://gateguard:REPLACE_WITH_STRONG_DATABASE_PASSWORD@postgres:5432/gateguard

MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=50
MAX_PDF_TEXT_CHARS=500000
MAX_IMAGE_PIXELS=40000000
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
EXTRACTION_PROVIDER=auto
CRITICAL_CONFIDENCE_THRESHOLD=0.75
MAX_AI_CONCURRENCY=4

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=45
PADDLE_DEVICE=cpu

BACKEND_API_URL=http://backend:8000
BACKEND_API_KEY=REPLACE_WITH_SAME_VALUE_AS_APP_API_KEY
BACKEND_TIMEOUT_MS=60000
